# Django Backend Settings
DJANGO_SECRET_KEY=django-insecure-bit2code-super-secret-key-change-in-prod-2026
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Database Configuration (PostgreSQL)
