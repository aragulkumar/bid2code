# Django Backend Settings
DJANGO_SECRET_KEY=django-insecure-bit2code-super-secret-key-change-in-prod-2026
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Database Configuration (PostgreSQL)
POSTGRES_DB=bit2code_db
POSTGRES_USER=bit2code_user
POSTGRES_PASSWORD=bit2code_password_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://bit2code_user:bit2code_password_2026@postgres:5432/bit2code_db

# Judge0 CE Configuration
JUDGE0_URL=http://judge0-server:2358
JUDGE0_CALLBACK_URL=http://backend:8000/api/submissions/judge0_callback/
JUDGE0_USE_MOCK_FALLBACK=True

# Redis Configuration (Optional for background tasks / caching)
REDIS_URL=redis://redis:6379/0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Firebase Configuration (For 24/7 Cloud Registration on Netlify)
# Add these values in Netlify Dashboard → Site settings → Environment variables
# Do NOT paste real keys here — this file is public on GitHub!
VITE_FIREBASE_API_KEY=replace_with_your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
VITE_FIREBASE_APP_ID=replace_with_app_id
VITE_FIREBASE_MEASUREMENT_ID=replace_with_measurement_id
